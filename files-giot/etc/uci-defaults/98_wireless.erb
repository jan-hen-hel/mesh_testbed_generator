uci -q batch <<EOF
  set wireless.radio1.disabled='0'
  set wireless.default_radio1.network='mgmt'
  set wireless.default_radio1.mode='sta'
  set wireless.default_radio1.ssid='SmartHomeLab-Mgmt'
  set wireless.default_radio1.encryption='sae'
  set wireless.default_radio1.key='<%= @secrets['mgmt_wlan_psk']%>'
  commit wireless
EOF


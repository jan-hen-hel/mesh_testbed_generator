config interface 'loopback'
        option device 'lo'
        option proto 'static'
        option ipaddr '127.0.0.1'
        option netmask '255.0.0.0'

config interface 'lan'
        option device 'eth1'
        option proto 'static'
        option ipaddr '198.19.1.1'
        option netmask '255.255.255.0'

config interface 'wan'
        option device 'eth0'
        option hostname 'apu-giot-<%= @node['apu_id'] %>-wan'
        option proto 'dhcp'

config interface 'mgmt'
        option proto 'dhcp'
        option hostname 'apu-giot-<%= @node['apu_id'] %>-mgmt'
        option device 'eth2'
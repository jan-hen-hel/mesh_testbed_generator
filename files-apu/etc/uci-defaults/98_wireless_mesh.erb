uci -q batch <<EOF
  set wireless.radio0.disabled='0'
  set wireless.default_radio0.network='lan'
  set wireless.default_radio0.mode='mesh'
  set wireless.default_radio0.mesh_id='smarthome-mesh'
  set wireless.default_radio0.encryption='sae'
  set wireless.default_radio0.mesh_fwding='1'
  set wireless.default_radio0.mesh_rssi_threshold='0'
  set wireless.default_radio0.key='<%= @secrets['mesh_wlan_psk']%>'

  set wireless.radio0.channel='165'
  set wireless.radio0.band='5g'
  set wireless.radio0.htmode='HE20'
  set wireless.radio0.country='NO'
  set wireless.radio0.cell_density='0'
  set wireless.radio0.txpower='10'

  commit wireless
EOF

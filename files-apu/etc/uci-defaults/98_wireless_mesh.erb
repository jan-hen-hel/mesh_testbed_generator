uci -q batch <<EOF
  set wireless.<%= @node['mesh_if']%>.disabled='0'
  set wireless.default_<%= @node['mesh_if']%>.network='lan'
  set wireless.default_<%= @node['mesh_if']%>.mode='mesh'
  set wireless.default_<%= @node['mesh_if']%>.mesh_id='smarthome-mesh'
  set wireless.default_<%= @node['mesh_if']%>.encryption='sae'
  set wireless.default_<%= @node['mesh_if']%>.mesh_fwding='1'
  set wireless.default_<%= @node['mesh_if']%>.mesh_rssi_threshold='0'
  set wireless.default_<%= @node['mesh_if']%>.key='<%= @secrets['mesh_wlan_psk']%>'

  set wireless.<%= @node['mesh_if']%>.channel='165'
  set wireless.<%= @node['mesh_if']%>.band='5g'
  set wireless.<%= @node['mesh_if']%>.htmode='HE20'
  set wireless.<%= @node['mesh_if']%>.country='NO'
  set wireless.<%= @node['mesh_if']%>.cell_density='0'
  set wireless.<%= @node['mesh_if']%>.txpower='10'

  commit wireless
EOF

uci -q batch <<EOF
  set wireless.radio1.disabled='0'
  set wireless.default_radio1.network='lan'
  set wireless.default_radio1.mode='mesh'
  set wireless.default_radio1.mesh_id='smarthome-mesh'
  set wireless.default_radio1.encryption='sae'
  set wireless.default_radio1.mesh_fwding='1'
  set wireless.default_radio1.mesh_rssi_threshold='0'
  set wireless.default_radio1.key='<%= @secrets['mesh_wlan_psk']%>'

  set wireless.radio1.channel='165'
  set wireless.radio1.band='5g'
  set wireless.radio1.htmode='HE20'
  set wireless.radio1.country='NO'
  set wireless.radio1.cell_density='0'
  set wireless.radio1.txpower='10'


  set wireless.radio0.disabled='0'
  set wireless.radio0.channel='<%= @node['wlan_channel'] %>'
  set wireless.default_radio0.network='lan'
  set wireless.default_radio0.mode='ap'
  set wireless.default_radio0.ssid='apu-<%= @node['apu_id'] %>-lan'
  set wireless.default_radio0.encryption='sae'
  set wireless.default_radio0.key='<%= @secrets['lan_wlan_psk']%>'

  commit wireless
EOF

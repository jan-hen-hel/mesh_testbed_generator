config interface 'loopback'
        option device 'lo'
        option proto 'static'
        option ipaddr '127.0.0.1'
        option netmask '255.0.0.0'

config device
        option name 'br-lan'
        option type 'bridge'
        list ports 'eth0'
        list ports 'eth1'
        list ports 'eth2'

config interface 'lan'
        option device 'br-lan'
        option proto 'static'
        option ipaddr '198.19.254.2<%= @node['apu_id'] %>'
        option netmask '255.255.255.0'
        option dns '8.8.8.8 8.8.4.4'

config route 'wired_default'
        option interface 'lan'
        option target '0.0.0.0/0'
        option gateway '198.19.254.1'
        option metric '10'

config interface 'p2p'
	option proto 'wireguard'
	option private_key "<%= @secrets['wireguard_keys'][@node['host_name']] %>"
	option mtu '1400'
	list addresses '198.19.250.2<%= @node['apu_id'] %>/24'

config wireguard_p2p
	option description 'vm'
	option public_key 'rotbOEGktIN/amXF/T96sETXl4iG197YnA+1Dzsz634='
	option endpoint_host '185.196.89.19'
	option endpoint_port '10020'
	option persistent_keepalive '15'
	option route_allowed_ips '1'
	list allowed_ips '198.19.250.1/32'


config interface 'module_0'
	option proto 'qmi'
	option device '/dev/cdc-wdm0'
	option apn 'telenor'
	option v6apn 'telenor'
	option auth 'none'
	option pdptype 'ipv4'
	option delegate '0'
        option metric '5'

config interface 'module_1'
	option proto 'qmi'
	option device '/dev/cdc-wdm1'
	option apn 'telia'
	option v6apn 'telia'
	option auth 'none'
	option pdptype 'ipv4'
	option delegate '0'
        option metric '8'


config interface 'loopback'
        option device 'lo'
        option proto 'static'
        option ipaddr '127.0.0.1'
        option netmask '255.0.0.0'

config device
        option name 'br-lan'
        option type 'bridge'
        list ports 'eth0'
        list ports 'eth1'
        list ports 'eth2'

config interface 'lan'
        option device 'br-lan'
        option proto 'static'
        option ipaddr '198.19.254.2<%= @node['apu_id'] %>'
        option netmask '255.255.255.0'

config route 'wired_default'
        option interface 'lan'
        option target '0.0.0.0/0'
        option gateway '198.19.254.1'
        option metric '10'
